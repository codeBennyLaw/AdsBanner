<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdsBanner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActivityTransitions">true</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_light</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/text_tertiary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AdsBanner.Dialog</item>
        <item name="materialButtonStyle">@style/Button.AdsBanner.Primary</item>
        <item name="textInputStyle">@style/Widget.AdsBanner.Input</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.RowTitle" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.RowSub" parent="">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Card.AdsBanner" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>

    <style name="Text.Metric" parent="">
        <item name="android:textColor">@color/stats_ink</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Setting.Row" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:minHeight">76dp</item>
    </style>

    <style name="Setting.Section" parent="Text.Section">
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Setting.Divider" parent="">
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="ShapeAppearance.AdsBanner.Control" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_control</item>
    </style>

    <style name="Button.AdsBanner.Primary" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AdsBanner.Control</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.AdsBanner.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AdsBanner.Control</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.AdsBanner.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AdsBanner.Control</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.AdsBanner.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AdsBanner.Control</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.AdsBanner.Icon" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AdsBanner.Pill</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.AdsBanner.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_control</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="ThemeOverlay.AdsBanner.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.AdsBanner</item>
        <item name="buttonBarPositiveButtonStyle">@style/Button.AdsBanner.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Button.AdsBanner.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Button.AdsBanner.Dialog</item>
    </style>

    <style name="ThemeOverlay.AdsBanner.OriginDialog" parent="ThemeOverlay.AdsBanner.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="MaterialAlertDialog.AdsBanner" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AdsBanner.Dialog</item>
    </style>

    <style name="ShapeAppearance.AdsBanner.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_dialog</item>
    </style>

    <style name="ShapeAppearance.AdsBanner.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Button.AdsBanner.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AdsBanner.Pill</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Button.AdsBanner.Back" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
        <item name="android:contentDescription">返回</item>
    </style>

    <style name="Widget.AdsBanner.RangeOption" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/bg_round_feedback</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/stats_range_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="Widget.AdsBanner.TypeOption" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">@drawable/bg_round_feedback</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.PageTitle" parent="Text.Title">
        <item name="android:textSize">24sp</item>
    </style>
</resources>
