<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Button.AdsBanner.Back"
            android:layout_width="48dp"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:id="@+id/tvPageTitle"
            android:text="拦截统计"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeatmap"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="热力图" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp"
            android:clipToPadding="false"
            android:scrollbars="none" />
        <ScrollView
            android:id="@+id/heatmapScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="28dp">
                <TextView
                    style="@style/Text.PageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="每天少一点打扰" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.AdsBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="每日拦截"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvHeatMeta"
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />
                        <HorizontalScrollView
                            android:id="@+id/heatScroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:scrollbars="none">
                            <com.adsbanner.clean.ui.HeatmapView
                                android:id="@+id/heatmap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </HorizontalScrollView>
                        <TextView
                            android:id="@+id/tvHeatLegend"
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingExtra="8dp" />
                        <TextView
                            android:id="@+id/tvHeatDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="@color/brand"
                            android:textSize="14sp"
                            android:visibility="gone" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="每格一天，颜色按每日拦截次数固定分档\n点击格子查看日期与次数，可左右滑动查看历史" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
