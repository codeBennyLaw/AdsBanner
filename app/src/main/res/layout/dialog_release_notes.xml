<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
    <TextView
        android:id="@+id/tvReleaseStatus"
        style="@style/Text.RowSub"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/text_secondary" />
        <FrameLayout android:layout_width="64dp" android:layout_height="24dp">
            <include android:id="@+id/releaseRefreshLoading" layout="@layout/view_local_loading"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/releaseDataRegion"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listReleases" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="8dp" android:scrollbars="vertical" />
        <include android:id="@+id/releaseLoading" layout="@layout/view_local_loading"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetryReleases"
        style="@style/Button.AdsBanner.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="重试加载"
        android:visibility="gone" />
</LinearLayout>
