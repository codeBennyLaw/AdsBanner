<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_gutter"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_badge"
                android:src="@drawable/ic_launcher_foreground"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />
                <TextView
                    style="@style/Text.RowSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_slogan" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardService"
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/dot_off" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvServiceState"
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="服务未开启" />
                        <TextView
                            android:id="@+id/tvServiceHint"
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="请开启无障碍服务" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnService"
                        style="@style/Button.AdsBanner.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:minWidth="64dp"
                        android:text="开启" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/cardStats"
            app:cardBackgroundColor="@color/stats_surface"
            android:transitionName="@string/transition_stats"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/Text.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="拦截统计" />
                        <TextView
                            android:id="@+id/tvStatsArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="详情"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTodayCount"
                                style="@style/Text.Metric"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0" />
                            <TextView
                                style="@style/Text.RowSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="今日拦截" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalCount"
                                style="@style/Text.Metric"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0" />
                            <TextView
                                style="@style/Text.RowSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="累计拦截" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        style="@style/Text.RowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂无拦截记录"
                        android:id="@+id/tvStatsMeta"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/Setting.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="广告拦截" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="开屏广告跳过" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="识别广告按钮并自动点击"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSplash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="开屏广告跳过" />
                </LinearLayout>
                <View
                    style="@style/Setting.Divider"
                    android:layout_width="match_parent" />
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="误触跳转拦截" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="广告自动打开其他应用时尝试返回"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchJump"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="误触跳转拦截" />
                </LinearLayout>
                <View
                    style="@style/Setting.Divider"
                    android:layout_width="match_parent" />
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/rowInAppAd">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="页面内广告清理" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="取消或关闭 B 站播放页暂停广告"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInAppAd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="页面内广告清理" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/Setting.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="管理" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/cardProtection"
            app:cardBackgroundColor="@color/management_surface"
            android:transitionName="@string/transition_protection"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="拦截管理" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="暂停、例外应用与补充规则"
                            android:layout_marginTop="4dp"
                            android:id="@+id/tvProtectionSummary" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/cardTargets"
            android:transitionName="@string/transition_targets"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="跳转拦截名单" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="选择需要拦截自动跳转的应用"
                            android:layout_marginTop="4dp"
                            android:id="@+id/tvTargetHint" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/Setting.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="后台运行" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="常驻通知" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="减少后台服务被清理"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchKeepAlive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="常驻通知" />
                </LinearLayout>
                <View
                    style="@style/Setting.Divider"
                    android:layout_width="match_parent" />
                <LinearLayout
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/rowNotify">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="拦截实时提示" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="拦截时显示通知"
                            android:layout_marginTop="4dp"
                            android:id="@+id/tvNotifyHint" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="拦截实时提示" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/Setting.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="系统设置" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/rowBattery"
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_round_feedback"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="电池优化" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="减少系统省电限制导致的中断"
                            android:layout_marginTop="4dp"
                            android:id="@+id/tvBatteryHint" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <View
                    style="@style/Setting.Divider"
                    android:layout_width="match_parent" />
                <LinearLayout
                    android:id="@+id/rowRom"
                    style="@style/Setting.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_round_feedback"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="后台设置说明" />
                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="自启动、后台活动与省电限制"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:id="@+id/versionLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/text_tertiary" />
            <TextView
                android:id="@+id/btnCheckUpdate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_round_feedback"
                android:clickable="true"
                android:focusable="true"
                android:text="检查更新"
                android:textSize="13sp"
                android:textColor="@color/brand" />
            <TextView
                android:id="@+id/btnReleaseNotes"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_round_feedback"
                android:clickable="true"
                android:focusable="true"
                android:text="更新日志"
                android:textSize="13sp"
                android:textColor="@color/brand" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linkRepo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_feedback"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_github_mark"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:tint="@color/text_tertiary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="GitHub 仓库"
                android:textSize="13sp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
