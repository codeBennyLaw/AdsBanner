<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/app_slogan"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/bg_badge"
                android:padding="6dp" />
        </LinearLayout>

        <!-- 服务状态 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/dot_off" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvServiceState"
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="无障碍服务未开启"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvServiceHint"
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="开启后才能拦截广告" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnService"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:text="去开启" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 统计 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStats"
            android:transitionName="@string/transition_stats"
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/brand_light"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拦截统计"
                    android:drawableStart="@drawable/ic_chart"
                    android:drawablePadding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTodayCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/brand_dark"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="今日拦截" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/brand_dark"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="累计拦截" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatsArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="详情"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawablePadding="4dp"
                        android:textColor="@color/brand_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatsMeta"
                    style="@style/Text.RowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="暂无拦截记录" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 拦截开关 -->
        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="拦截开关" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开屏广告自动跳过" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="识别「跳过」按钮并自动点击" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSplash"
                        android:contentDescription="开屏广告自动跳过"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="误触跳转拦截" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="广告期间被自动拉起时尝试返回" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchJump"
                        android:contentDescription="误触跳转拦截"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/rowInAppAd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="页面内广告清理" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="关闭播放页暂停广告等覆盖广告" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInAppAd"
                        android:contentDescription="页面内广告清理"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="常驻通知" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="提升进程优先级，降低被清理概率" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchKeepAlive"
                        android:contentDescription="常驻通知"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/rowNotify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_round_feedback"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="拦截实时提示" />

                        <TextView
                            android:id="@+id/tvNotifyHint"
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="拦截时在状态栏 / 灵动岛显示 10 秒" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotify"
                        android:contentDescription="拦截实时提示"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 名单 -->
        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="跳转拦截名单" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTargets"
            android:transitionName="@string/transition_targets"
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="管理拦截名单" />

                    <TextView
                        android:id="@+id/tvTargetHint"
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="已启用 0 个应用" />
                </LinearLayout>

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        android:contentDescription="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 保活 -->
        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="后台存活" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.AdsBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_round_feedback"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="加入电池优化白名单" />

                        <TextView
                            android:id="@+id/tvBatteryHint"
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="避免系统休眠时断开服务" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/rowRom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_round_feedback"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="国产 ROM 自启动设置" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="小米/华为/OPPO/vivo 需手动允许后台运行" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 版本与仓库 -->
        <LinearLayout
            android:id="@+id/versionLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCheckUpdate"
                android:minHeight="48dp"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_round_feedback"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp"
                android:text="检查更新"
                android:textColor="@color/brand"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnReleaseNotes"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:background="@drawable/bg_round_feedback"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp"
                android:text="更新日志"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkRepo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_feedback"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_github_mark"
                app:tint="@color/text_tertiary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="GitHub 仓库"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
